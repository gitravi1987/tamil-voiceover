{
  "manifest_version": 3,
  "name": "Tamil Voiceover for Netflix",
  "version": "0.0.1",
  "description": "Live conversational-Tamil voiceover from Netflix subtitles (personal use).",
  "permissions": ["storage"],
  "host_permissions": ["https://www.netflix.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/watch/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Tamil Voiceover" }
}
